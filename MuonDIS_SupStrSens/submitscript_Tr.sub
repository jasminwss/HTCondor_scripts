executable          	= submitscript.sh
notify_user				= jasmin.weiss@student.hu-berlin.de
notification 			= Error

# Defaults can be overridden on the command line, e.g. condor_submit submitscript_Tr.sub NJOBS=200
# NJOBS * MUONS_PER_JOB >= number of muons in muonsProduction_wsoft_Tr.root (printed at the end of step 0)
DIS_BASE        = $(OUTDIR:/eos/user/j/jaweiss/MuonDIS/TRY6LiSc_SupStrSens)
arguments 		= $(DIS_BASE)/Tr $(DIS_BASE)/muonsProduction_wsoft_Tr.root $(Process) $(MUONS_PER_JOB:1) $(DIS_PER_MUON:1000)

##############################################################################################################
error 					= logs/muondisTr_$(Cluster)_$(Process).err
log 					= logs/muondisTr_$(Cluster).log
output					= logs/muondisTr_$(Cluster)_$(Process).out
##############################################################################################################

request_CPUs   = 1
request_memory = 4 GB
request_disk   = 5 GB

on_exit_remove   		= (ExitBySignal == False) && (ExitCode == 0)
max_retries      		= 3
requirements     		= (OpSysAndVer =?= "AlmaLinux9") && (Machine =!= LastRemoteHost)
+REQUIRED_OS 			= "AlmaLinux9"

# caps how many jobs run at once, so the AFS-hosted FairShip workspace is not hit by hundreds of jobs simultaneously
max_materialize = 200

##############################################################################################################
+JobFlavour = "tomorrow"
##############################################################################################################
queue $(NJOBS)
