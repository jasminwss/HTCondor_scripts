executable          	= submitscript.sh
transfer_output_files 	= ""
notify_user				= jasmin.weiss@student.hu-berlin.de
notification 			= Always

arguments 		= /afs/cern.ch/work/j/jaweiss/private/bkg $(inputFile) $(startEvent) $(nEvents) $(Process) $(ClusterId) 

##############################################################################################################
error 					= /afs/cern.ch/work/j/jaweiss/private/HTCondorfiles/error/muonBack_$(Process).err
log 					= /afs/cern.ch/work/j/jaweiss/private/HTCondorfiles/log/muonBack_$(Process).log
output					= /afs/cern.ch/work/j/jaweiss/private/HTCondorfiles/output/muonBack_$(Process).out
##############################################################################################################

on_exit_remove   		= (ExitBySignal == False) && (ExitCode == 0)
max_retries      		= 3
requirements     		= Machine =!= LastRemoteHost 

##############################################################################################################
+JobFlavour = "nextweek"
##############################################################################################################
queue inputFile,startEvent,nEvents from /afs/cern.ch/work/j/jaweiss/private/HTCondor_scripts/MuonBack/inputfile_list_1spill.txt




